pipeline {
    agent any

    environment {
        BASE_IMAGE      = 'node:20-alpine'
        DOCKER_REGISTRY = 'aboubacar99'
        APP_NAME        = 'pulse-api'
        DOCKER_IMAGE    = "${DOCKER_REGISTRY}/${APP_NAME}:${GIT_COMMIT}"
        // Cache NVD / CVE pour OWASP Dependency-Check (persistant sur l'agent)
        OWASP_DATA_DIR  = '/var/lib/jenkins/dependency-check-data'
        APPLICATION_URL = 'http://localhost:3000'
    }

    stages {
        stage('Unit Tests and Coverage Jest Coverage') {
            when {
                anyOf {
                    changeset 'pulse/api/**'
                    buildingTag()
                }
            }
            steps {
                dir('pulse/api') {
                    sh 'npm ci'
                    sh 'npm run test:coverage'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'pulse/api/coverage/junit.xml'
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: 'pulse/api/coverage/cobertura-coverage.xml']],
                        id: 'api-coverage',
                        name: 'API Coverage'
                    )
                    publishHTML target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'pulse/api/coverage',
                        reportFiles: 'index.html',
                        reportName: 'Jest Coverage Report'
                    ]
                }
            }
        }

        stage('Mutation Tests - Stryker') {
            when {
                anyOf {
                    changeset 'pulse/api/**'
                    buildingTag()
                }
            }
            steps {
                dir('pulse/api') {
                    sh 'npm ci'
                    sh 'npm run test:mutation'
                }
            }
            post {
                always {
                    publishHTML target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'pulse/api/reports/mutation',
                        reportFiles: 'mutation.html',
                        reportName: 'Stryker Mutation Report'
                    ]
                }
            }
        }

        stage('SonarQube') {
            when {
                anyOf {
                    changeset 'pulse/api/**'
                    buildingTag()
                }
            }
            steps {
                dir('pulse/api') {
                    sh 'npm ci'
                    sh 'npm run test:coverage'   // génère coverage/lcov.info pour Sonar
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                    npx sonar-scanner-npm \
                        -Dsonar.host.url=http://100.50.5.73:9000 \
                        -Dsonar.token=$SONAR_TOKEN \
                        -Dsonar.projectKey=pulse-api
                    '''
                    }
                }
            }
        }

        stage('Vulnerability Scan - Docker') {
            when {
                anyOf {
                    changeset 'pulse/api/**'
                    buildingTag()
                }
            }
            steps {
                parallel(
                    'Dependency Scan': {
                        dir('pulse/api') {
                            sh 'npm ci'
                            // Gate strict : deps de prod uniquement
                            sh 'npm audit --audit-level=high --omit=dev'
                            // OWASP (NVD cache) : CVE aussi dans les outils de scan (sonar/jest-junit/owasp)
                            // → UNSTABLE sans bloquer le pipeline en lab
                            sh 'mkdir -p "$OWASP_DATA_DIR"'
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                                    sh 'npm run test:owasp -- --nvdApiKey=$NVD_API_KEY'
                                }
                            }
                        }
                    },

                    'Trivy Scan': {
                        dir('pulse/api') {
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                sh "bash trivy-docker-image-scan.sh ${BASE_IMAGE}"
                            }
                        }
                    },
                    'OPA Conftest': {
                        dir('pulse/api') {
                            sh 'docker run --rm -v $(pwd):/project openpolicyagent/conftest test --policy opa-docker-security.rego Dockerfile'
                        }
                    }
                )
            }

            post {
                always {
                    // Rapport XML → plugin OWASP Dependency-Check
                    // dependencyCheckPublisher(
                    //         pattern: 'pulse/api/owasp/dependency-check-report.xml'
                    //     )
                    // Optionnel : aussi le HTML
                    publishHTML target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'pulse/api/owasp',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency-Check'
                    ]
                }
            }
        }

        stage('Build') {
            when {
                anyOf {
                    changeset 'pulse/api/**'
                    buildingTag()
                }
            }
            steps {
                withDockerRegistry([credentialsId: 'docker-hub', url: '']) {
                    dir('pulse/api') {
                        sh 'docker build -t ${DOCKER_IMAGE} .'
                        sh 'docker push ${DOCKER_IMAGE}'
                        sh 'docker tag ${DOCKER_IMAGE} ${DOCKER_REGISTRY}/${APP_NAME}:latest'
                        sh 'docker push ${DOCKER_REGISTRY}/${APP_NAME}:latest'
                    }
                }
            }
        }

        stage('Vulnerability Scan - Kubernetes') {
            when {
                anyOf {
                    changeset 'pulse/api/**'
                    buildingTag()
                }
            }
            steps {
                parallel(
                    'OPA Scan': {
                        dir('pulse/api') {
                            sh 'docker run --rm -v $(pwd):/project openpolicyagent/conftest test --policy opa-k8s-security.rego k8s/'
                        }
                    },
                    'Kubesec Scan': {
                        dir('pulse/api') {
                            sh 'bash kubesec-scan.sh'
                        }
                    },
                    'Trivy Scan': {
                        dir('pulse/api') {
                            sh 'bash trivy-k8s-scan.sh'
                        }
                    }
                )
            }
        }

    // stage('OWASP ZAP - DAST') {
    //     when {
    //         anyOf {
    //             changeset 'pulse/api/**'
    //             buildingTag()
    //         }
    //     }
    //     steps {
    //         dir('pulse/api') {
    //             sh 'bash zap.sh'
    //         }
    //     }
    //     post {
    //         always {
    //             publishHTML target: [
    //                 allowMissing: true,
    //                 alwaysLinkToLastBuild: true,
    //                 keepAll: true,
    //             ]
    //             publishHTML target: [
    //                 allowMissing: true,
    //                 alwaysLinkToLastBuild: true,
    //                 keepAll: true,
    //                 reportDir: 'pulse/api/owasp',
    //                 reportFiles: 'zap_report.html',
    //                 reportName: 'OWASP ZAP'
    //             ]
    //         }
    //     }
    // }
    }

    post {
        success {
            echo 'Pipeline completed successfully'
        }
        failure {
            echo 'Pipeline completed with failures'
        }
        unstable {
            echo 'Pipeline completed with instabilities'
        }
        changed {
            echo 'Pipeline completed with changes'
        }
        aborted {
            echo 'Pipeline completed with abort'
        }
    }
}

pipeline {
  agent any
  stages {
    stage('Build') {
      when {
        anyOf {
          changeset "pulse/api/**"
          // utile au 1er build / rebuild manuel
          buildingTag()
        }
      }
      steps {
        dir('pulse/api') {
          sh 'docker build -t santu/pulse-api .'
        }
      }
    }
  }
}
pipeline {
    agent any
    stages {
        stage('Build') {
                when {
                    anyOf {
                        changeset 'pulse/vote/**'
                        buildingTag()
                    }
                }
                steps {
                    withDockerRegistry([credentialsId: 'docker-hub', url: '']) {
                        dir('pulse/vote') {
                            sh 'docker build -t aboubacar99/pulse-vote:""$GIT_COMMIT"" .'
                            sh 'docker push aboubacar99/pulse-vote:""$GIT_COMMIT""'
                        }
                    }
                }
        }
    }
}

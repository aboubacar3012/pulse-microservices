pipeline {
    agent any

        environment {
        DOCKER_REGISTRY = 'aboubacar99'
        APP_NAME        = 'pulse-worker'
        DOCKER_IMAGE    = "${DOCKER_REGISTRY}/${APP_NAME}:${GIT_COMMIT}"
        }

    stages {
        stage('Unit Tests - JUnit and JaCoCo') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                dir('pulse/worker') {
                    sh 'mvn clean test'
                }
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                    jacoco execPattern: 'target/jacoco.exec'
                }
            }
        }

        stage('Build Artifact - Maven') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                dir('pulse/worker') {
                    sh 'mvn package -DskipTests=true'
                    archive 'target/*.jar'
                }
            }
        }

        stage('Build') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                withDockerRegistry([credentialsId: 'docker-hub', url: '']) {
                    dir('pulse/worker') {
                        sh 'docker build -t ${DOCKER_IMAGE} .'
                        sh 'docker push ${DOCKER_IMAGE}'
                    }
                }
            }
        }
    }
}

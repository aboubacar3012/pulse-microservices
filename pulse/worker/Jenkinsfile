        environment {
            DOCKER_REGISTRY = 'aboubacar99'
            APP_NAME        = 'pulse-worker'
            DOCKER_IMAGE    = "${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}-${GIT_COMMIT}"
            OWASP_DATA_DIR  = '/var/lib/jenkins/dependency-check-data'
        }

    stages {

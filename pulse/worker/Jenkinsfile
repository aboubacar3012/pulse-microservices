pipeline {
    agent any

        environment {
            DOCKER_REGISTRY = 'aboubacar99'
            APP_NAME        = 'pulse-worker'
            DOCKER_IMAGE    = "${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}-${GIT_COMMIT}"
        }

    stages {
        stage('Unit Tests - JUnit and JaCoCo') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                dir('pulse/worker') {
                    // sh 'mvn clean test'
                    // -B option est utilisé pour exécuter Maven en mode batch, ce qui est utile dans les environnements CI/CD pour éviter les invites interactives.
                    sh 'mvn -B clean verify'
                }
            }
            post {
                always {
                    junit 'pulse/worker/target/surefire-reports/*.xml'
                    jacoco execPattern: 'pulse/worker/target/jacoco.exec'
                }
            }
        }

        stage('Mutation Tests - PIT') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }

            steps {
                dir('pulse/worker') {
                    // sh 'mvn org.pitest:pitest-maven:mutationCoverage'
                    // -B option est utilisé pour exécuter Maven en mode batch, ce qui est utile dans les environnements CI/CD pour éviter les invites interactives.
                    sh 'mvn -B org.pitest:pitest-maven:mutationCoverage -DwithHistory=false'
                }
            }

            post {
                always {
                    dir('pulse/worker') {
                        publishHTML(target: [
                            reportDir: 'target/pit-reports',
                            reportFiles: '**/index.html',
                            reportName: 'PIT Mutation Report'
                        ])
                    }
                }
            }
        }

        stage('SonarQube - Maven') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                withCredentials([string(credentialsId: 'sonar-token-pulse-worker', variable: 'SONAR_TOKEN')]) {
                    dir('pulse/worker') {
                        sh '''
                            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar \
                                -Dsonar.host.url=http://100.50.5.73:9000 \
                                -Dsonar.token="$SONAR_TOKEN" \
                                -Dsonar.projectKey=pulse-worker \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        // Conservé pour la formation : l’image Docker contient déjà le JAR, donc cette archive n’est pas nécessaire au déploiement.
        // Elle peut toutefois servir à télécharger le JAR depuis Jenkins ou à le transmettre à un autre job sans le reconstruire.
        stage('Build Artifact - Maven') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                archiveArtifacts artifacts: 'pulse/worker/target/pulse-worker.jar',
                    fingerprint: true // ici le figerprint est utile pour retrouver le JAR dans d’autres jobs, par exemple pour le déployer sur un serveur distant via SSH.
            }
        }

        // stage('Build') {
        //     when {
        //         anyOf {
        //             changeset 'pulse/worker/**'
        //             buildingTag()
        //         }
        //     }
        //     steps {
        //         withDockerRegistry([credentialsId: 'docker-hub', url: '']) {
        //             dir('pulse/worker') {
        //                 sh 'printenv'
        //                 sh 'docker build -t ${DOCKER_IMAGE} .'
        //                 sh 'docker push ${DOCKER_IMAGE}'
        //                 sh 'docker tag ${DOCKER_IMAGE} ${DOCKER_REGISTRY}/${APP_NAME}:latest'
        //                 sh 'docker push ${DOCKER_REGISTRY}/${APP_NAME}:latest'
        //             }
        //         }
        //     }
        // }

    // stage('K8S Deployment - DEV') {
    //     when {
    //         anyOf {
    //             changeset 'pulse/worker/**'
    //             buildingTag()
    //         }
    //     }
    //     steps {
    //         withKubeConfig([credentialsId: 'kubeconfig']) {
    //             dir('pulse/worker') {
    //                 sh 'bash k8s.sh'
    //                 sh 'bash k8s-rollout-status.sh'
    //             }
    //         }
    //     }
    // }
    }
}

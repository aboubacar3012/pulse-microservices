        stage('Vulnerability Scan - Docker') {
            when {
                anyOf {
                    changeset 'pulse/worker/**'
                    buildingTag()
                }
            }
            steps {
                parallel(
                    'Dependency Scan': {
                        dir('pulse/worker') {
                            sh 'mkdir -p "$OWASP_DATA_DIR"'
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                                    sh 'mvn dependency-check:check -Ddependency-check.suppressionFiles=dependency-check-suppression.xml -Ddata.directory="$OWASP_DATA_DIR" -DnvdApiKey="$NVD_API_KEY"'
                                }
                            }
                        }
                    },
              // 'Trivy Scan': {
              //     sh 'bash trivy-docker-image-scan.sh'
              // },
              // 'OPA Conftest': {
              //     sh 'docker run --rm -v $(pwd):/project openpolicyagent/conftest test --policy opa-docker-security.rego Dockerfile'
              // }
              )
            }

            post {
                always {
                    // Rapport XML → plugin OWASP Dependency-Check
                    // dependencyCheckPublisher(
                    //         pattern: 'pulse/worker/owasp/dependency-check-report.xml'
                    //     )
                    // Optionnel : aussi le HTML
                    publishHTML target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'pulse/worker/owasp',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency-Check'
                    ]
                }
            }
        }

        // Conservé pour la formation : l’image Docker contient déjà le JAR, donc cette archive n’est pas nécessaire au déploiement.
        // Elle peut toutefois servir à télécharger le JAR depuis Jenkins ou à le transmettre à un autre job sans le reconstruire.
